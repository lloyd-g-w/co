{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "co",
  "mainBinaryName": "co-desktop",
  "version": "0.1.0",
  "identifier": "io.github.lloyd-g-w.co",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @co/web dev",
    "beforeBuildCommand": "pnpm --filter @co/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "co",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "co, the coding agent",
    "longDescription": "The co web frontend in a native window, with this machine connected as a tool host while it is open.",
    "homepage": "https://github.com/lloyd-g-w/co",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
